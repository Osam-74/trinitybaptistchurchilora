# Admin portal route — set this in Vercel Environment Variables
NEXT_PUBLIC_ADMIN_PATH=sanctuary-g8

# ── Cloudflare R2 (file uploads: sermon audio + gallery photos) ──
# Shared with the consultdrfat repo via the same Cloudflare Worker.
# Set this in Vercel → Project Settings → Environment Variables:
NEXT_PUBLIC_CF_WORKER_URL=https://consultdrfat-api.ogmediainc.workers.dev
# Optional: public R2 CDN base (Worker falls back to /files/ if unset)
# NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-xxxx.r2.dev
