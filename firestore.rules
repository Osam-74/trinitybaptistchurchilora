rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: allows public updates that ONLY change the likeCount field
    function isPublicLikeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']);
    }

    // Hymns — public read, admin write
    match /hymns/{hymnId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site settings — public read, admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Church leadership — public read, admin write
    match /leaders/{leaderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Choir & Media Team members
    match /choir_members/{memberId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Gallery albums — public read, admin write
    match /gallery_albums/{albumId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery photos — public read, admin write
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact messages — anyone can create (submit form), admin reads/deletes
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, delete: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Bookings — anyone can create (submit booking), admin reads/updates/deletes
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Admin user profiles
    match /admin_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Site config (Pastor's Word, etc.) — public read, admin write
    match /site_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Latest News & Events — public read, admin write, public like updates
    match /news_posts/{postId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || isPublicLikeUpdate();
    }

    // Sermons — public read, admin write, public like updates
    match /sermons/{sermonId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || isPublicLikeUpdate();
    }

    // Faith Articles — public read, admin write, public like updates
    match /faith_articles/{articleId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || isPublicLikeUpdate();
    }

    // Ministry members — public read & create (registration form), admin update/delete
    match /ministry_members/{memberId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Activity log — admin read/write
    match /activity_log/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Content views (analytics) — anyone can create (track views), admin can read
    match /content_views/{viewId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Pastor's Daily Declarations — public read + Amen, admin write
    match /pastor_declarations/{declId} {
      allow read: if true;
      // Public can increment amenCount (Amen button on homepage)
      allow update: if true;
      // Only authenticated admins can create or delete
      allow create, delete: if request.auth != null;
    }


    // Post comments — anyone can create & read visible ones, admin can delete/hide
    match /post_comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
